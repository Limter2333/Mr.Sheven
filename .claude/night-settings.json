{
  "_comment": "仅由 scripts/night-run.ps1 通过 --settings 加载，不影响日常交互式会话的权限。deny 优先级高于 allow。",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "NotebookEdit",
      "Task",
      "TodoWrite",

      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git stash:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git rev-parse:*)",

      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(py:*)",
      "Bash(pytest:*)",
      "Bash(node:*)",
      "Bash(npm test:*)",
      "Bash(npm run:*)",
      "Bash(npx:*)",
      "Bash(pnpm:*)",
      "Bash(yarn:*)",
      "Bash(make:*)",
      "Bash(go test:*)",
      "Bash(cargo test:*)",
      "Bash(mvn:*)",
      "Bash(gradle:*)",

      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(echo:*)",
      "Bash(diff:*)",
      "Bash(sort:*)",
      "Bash(jq:*)"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git remote:*)",
      "Bash(git reset:*)",
      "Bash(git clean:*)",
      "Bash(git rebase:*)",
      "Bash(git filter-branch:*)",
      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(del:*)",
      "Bash(Remove-Item:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(npm i -g:*)",
      "Bash(npm install -g:*)",
      "Bash(pip install:*)",
      "Bash(sudo:*)",
      "Bash(chmod:*)",
      "Bash(taskkill:*)",
      "Bash(reg:*)",
      "Bash(powercfg:*)",

      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/id_rsa*)",
      "Read(./**/credentials*)",
      "Read(./.claude/**)",

      "Write(./.env)",
      "Write(./.env.*)",
      "Write(./**/.env)",
      "Write(./**/.env.*)",
      "Write(./**/*.pem)",
      "Write(./**/*.key)",
      "Write(./.claude/**)",
      "Write(./CLAUDE.md)",
      "Write(./scripts/night-run.ps1)",

      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./**/.env)",
      "Edit(./**/.env.*)",
      "Edit(./**/*.pem)",
      "Edit(./**/*.key)",
      "Edit(./.claude/**)",
      "Edit(./CLAUDE.md)",
      "Edit(./scripts/night-run.ps1)",

      "WebFetch",
      "WebSearch"
    ]
  }
}